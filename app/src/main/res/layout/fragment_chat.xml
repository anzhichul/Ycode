<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_horizontal_padding"
    android:paddingTop="5dp"
    android:paddingEnd="@dimen/page_horizontal_padding"
    android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/historyButton" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_header_button" android:gravity="center" android:text="☰" android:textColor="@color/ink" android:textSize="17sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.14" android:text="CONVERSATION" android:textColor="#98A3B3" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/topic" android:layout_width="220dp" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="新对话" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
        <ImageView android:id="@+id/ycodeIcon" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_header_button" android:contentDescription="Ycode" android:padding="7dp" android:src="@drawable/ic_launcher" />
        <TextView android:id="@+id/runButton" android:layout_width="48dp" android:layout_height="38dp" android:layout_marginEnd="5dp" android:background="@drawable/bg_blue_pill" android:gravity="center" android:text="运行" android:textColor="@color/blue" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/workspaceButton" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_header_button" android:gravity="center" android:text="⌂" android:textColor="@color/blue" android:textSize="17sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="16dp">
            <FrameLayout android:layout_width="120dp" android:layout_height="120dp">
                <View android:layout_width="114dp" android:layout_height="114dp" android:layout_gravity="center" android:background="@drawable/bg_orbit" />
                <TextView android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="center" android:background="@drawable/bg_terminal" android:clipToOutline="true" android:elevation="0dp" android:gravity="center" android:outlineProvider="background" android:text="Y_" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
            </FrameLayout>
            <TextView android:id="@+id/emptyMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:letterSpacing="0.20" android:text="YCODE" android:textColor="@color/blue" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/emptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="center" android:text="今天想做些什么？" android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/emptyDescription" android:layout_width="280dp" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:lineSpacingExtra="2dp" android:text="聊天、分析源码或交给 Ycode 一个任务。" android:textColor="@color/muted" android:textSize="13sp" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/messages" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="12dp" android:paddingBottom="14dp" android:scrollbars="none" />
    </FrameLayout>

    <LinearLayout android:id="@+id/taskPlan" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp" android:background="@drawable/bg_task_plan" android:orientation="vertical" android:paddingStart="11dp" android:paddingTop="8dp" android:paddingEnd="11dp" android:paddingBottom="8dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="任务进度" android:textColor="@color/text" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/taskPlanCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 / 0" android:textColor="@color/muted" android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/taskPlanItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginBottom="7dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/modelChip" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/bg_blue_pill" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:paddingHorizontal="10dp" android:text="未选择模型  ⌄" android:textColor="#53647D" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/chatMode" android:layout_width="58dp" android:layout_height="28dp" android:layout_marginStart="7dp" android:gravity="center" android:text="聊天" android:textColor="@color/muted" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/taskMode" android:layout_width="58dp" android:layout_height="28dp" android:layout_marginStart="5dp" android:background="@drawable/bg_blue_pill" android:gravity="center" android:text="任务" android:textColor="@color/blue" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_composer" android:clipToOutline="true" android:elevation="0dp" android:forceHasOverlappingRendering="false" android:orientation="vertical" android:outlineProvider="background" android:paddingStart="12dp" android:paddingTop="5dp" android:paddingEnd="7dp" android:paddingBottom="6dp">
        <HorizontalScrollView android:id="@+id/attachmentScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:visibility="gone">
            <LinearLayout android:id="@+id/attachmentRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="3dp" android:paddingBottom="3dp" />
        </HorizontalScrollView>
        <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@android:color/transparent" android:gravity="top" android:hint="发送消息给 Ycode..." android:inputType="textCapSentences|textMultiLine" android:maxLength="4000" android:maxLines="4" android:minHeight="34dp" android:paddingTop="5dp" android:paddingBottom="0dp" android:textColor="@color/text" android:textColorHint="#9AA5B4" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical|end" android:orientation="horizontal">
            <TextView android:id="@+id/attach" android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="添加图片或源码文件" android:gravity="center" android:text="＋" android:textColor="#65748A" android:textSize="19sp" />
            <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="聊天模式" android:textColor="#98A3B3" android:textSize="9sp" />
            <TextView android:id="@+id/send" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_send_disabled" android:contentDescription="输入内容后发送" android:enabled="false" android:elevation="0dp" android:gravity="center" android:text="↑" android:textColor="#9AA5B4" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<LinearLayout
    android:layout_width="@dimen/history_drawer_width"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/white"
    android:elevation="18dp"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="历史会话" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/historyCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="暂无历史记录" android:textColor="@color/muted" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/newChat" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_blue_pill" android:gravity="center" android:text="＋" android:textColor="@color/blue" android:textSize="19sp" />
        <TextView android:id="@+id/closeDrawer" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/bg_header_button" android:gravity="center" android:text="×" android:textColor="@color/text" android:textSize="20sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5EAF2" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="9dp" />
    </ScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5EAF2" />
    <TextView android:id="@+id/rulesButton" android:layout_width="match_parent" android:layout_height="56dp" android:drawableEnd="@drawable/ic_chevron_right" android:drawablePadding="8dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="✦  全局聊天规则" android:textColor="@color/text" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
