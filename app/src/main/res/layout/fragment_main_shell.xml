<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page">

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="72dp" />

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/tabGlass"
        android:layout_width="@dimen/bottom_tab_width"
        android:layout_height="58dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass"
        android:clipToOutline="true"
        android:elevation="0dp"
        android:forceHasOverlappingRendering="false"
        android:outlineProvider="background">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="5dp">
            <TextView android:id="@+id/tabHome" style="@style/YcodeTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⌂  首页" />
            <TextView android:id="@+id/tabModels" style="@style/YcodeTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="◇  模型" />
            <TextView android:id="@+id/tabCloud" style="@style/YcodeTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▥  统计" />
            <TextView android:id="@+id/tabProfile" style="@style/YcodeTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="○  关于" />
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</FrameLayout>
