<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/visual" android:layout_width="180dp" android:layout_height="180dp" android:background="@drawable/bg_dark_card" android:gravity="center" android:text="Y_" android:textColor="@color/white" android:textSize="48sp" android:textStyle="bold" />
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp" android:gravity="center" android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:lineSpacingExtra="5dp" android:textColor="@color/muted" android:textSize="17sp" />
</LinearLayout>
