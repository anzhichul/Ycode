<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ycode" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Ycode.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
    <style name="Theme.Ycode.Preview" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:statusBarColor">#66000000</item>
        <item name="android:navigationBarColor">#66000000</item>
    </style>
</resources>
